, Tung Chung (東涌), Lantau Island (大嶼山), Hong Kong. Coordinates: OpenStreetMap hamlet node (22.277005, 113.934380). Ref: Tung Chung–Tai O Study Report (東涌至大澳研究報告), PDF p.102 (printed p.74) Table 38: '黃家圍村的歷史建築／歷史地點：黃家圍村村口及神壇（閘門公／伯公）' — Address: '黃家圍村入口，與龍井頭村的分界附近'; History: '黃家圍村的圍牆已經倒塌，村口現存兩塊石柱和一座放置了石頭代表神靈的小神壇，是黃家圍村唯一一個神壇。有人認為兩塊石柱是閘門公，小神壇供奉的石頭是伯公。' This matches P11 '黃家圍圍門' and P12 '黃家圍圍門 門旁' — the village gate/pillars at the entrance of 黃家圍. PDF p.99 (printed p.71): '村名雖有一「圍」字，但沒有發現圍牆' (despite '圍' in the name, no wall found — wall already collapsed). Confidence: MEDIUM-HIGH — specific feature documented in study report.","check":"✔️","clearing_note":"對比HKMS地圖63D9SE13B00 digital typographic map（https://www.hkmapservice.gov.hk/OneStopSystem/map-search?product=OSSCatB）大概位置與google地圖標示位置有偏差，根據政府研究報告黃家圍與龍井頭佔地合併，因此認為AI提供的地點與Google地圖不完全吻合是合理的。Item no P011-20都是黃家圍附近拍攝，難以辨認實際地標，選擇統一座標。","photo_path":"B03P11.jpg"},"geometry":{"type":"Point","coordinates":[113.93438,22.27701]}},{"type":"Feature","properties":{"record_no":"P12","box_no":"B03","photo_no":"B03P12","remarks_raw":"黃家圍圍門 門旁","Location_note":"黃家圍圍門 門旁","latitude":22.27701,"longitude":113.93438,"coordinate_source":"Google Maps (user-provided) + OpenStreetMap + HK Gov sources + Tung Chung Tai O Study Report (PDF)","coordinate_confidence":"MEDIUM-HIGH","coordinate_note":"黃家圍 (Wong Ka Wai), Tung Chung (東涌), Lantau Island (大嶼山), Hong Kong. Coordinates: OpenStreetMap hamlet node (22.277005, 113.934380). Ref: Tung Chung–Tai O Study Report (東涌至大澳研究報告), PDF p.102 (printed p.74) Table 38: '黃家圍村的歷史建築／歷史地點：黃家圍村村口及神壇（閘門公／伯公）' — Address: '黃家圍村入口，與龍井頭村的分界附近'; History: '黃家圍村的圍牆已經倒塌，村口現存兩塊石柱和一座放置了石頭代表神靈的小神壇，是黃家圍村唯一一個神壇。有人認為兩塊石柱是閘門公，小神壇供奉的石頭是伯公。' This matches P11 '黃家圍圍門' and P12 '黃家圍圍門 門旁' — the village gate/pillars at the entrance of 黃家圍. PDF p.99 (printed p.71): '村名雖有一「圍」字，但沒有發現圍牆' (despite '圍' in the name, no wall found — wall already collapsed). Confidence: MEDIUM-HIGH — specific feature documented in study report.","check":"✔️","clearing_note":null,"photo_path":"B03P12.jpg"},"geometry":{"type":"Point","coordinates":[113.93438,22.27701]}},{"type":"Feature","properties":{"record_no":"P13","box_no":"B03","photo_no":"B03P13","remarks_raw":"黃家圍村口 近馬路","Location_note":"黃家圍村口 近馬路","latitude":22.27701,"longitude":113.93438,"coordinate_source":"Google Maps (user-provided) + OpenStreetMap + HK Gov sources + Tung Chung Tai O Study Report (PDF)","coordinate_confidence":"MEDIUM-HIGH","coordinate_note":"黃家圍 (Wong Ka Wai), Tung Chung (東涌), Lantau Island (大嶼山), Islands District (離島區), Hong Kong. Coordinates: OpenStreetMap hamlet node (22.277005, 113.934380). Also confirmed by: HK Gov wastereduction.gov.hk (22.276964, 113.933678), HK Lands Dept Traverse Map No.9, NLB Route 11 bus stop, 2019 HAD Rural Election (composite indigenous village 黃家圍及龍井頭). Ref: Tung Chung–Tai O Study Report (東涌至大澳研究報告), PDF p.99 (printed p.71) §3.1.5: '黃家圍是一條東涌的村落，位於上嶺皮、下嶺皮與龍井頭之間。村民為黃氏，他們的祖先是龍井頭黃氏的分支。' PDF p.102 (printed p.74) Table 38: 黃家圍村村口及神壇（閘門公/伯公）. Confidence: MEDIUM — village-level, not building-level.","check":"✔️","clearing_note":null,"photo_path":"B03P13.jpg"},"geometry":{"type":"Point","coordinates":[113.93438,22.27701]}},{"type":"Feature","properties":{"record_no":"P14","box_no":"B03","photo_no":"B03P14","remarks_raw":"黃家圍 破屋","Location_note":"黃家圍 破屋","latitude":22.27701,"longitude":113.93438,"coordinate_source":"Google Maps (user-provided) + OpenStreetMap + HK Gov sources + Tung Chung Tai O Study Report (PDF)","coordinate_confidence":"LOW","coordinate_note":"黃家圍 (Wong Ka Wai), Tung Chung (東涌), Lantau Island (大嶼山), Islands District (離島區), Hong Kong. Coordinates: OpenStreetMap hamlet node (22.277005, 113.934380). Also confirmed by: HK Gov wastereduction.gov.hk (22.276964, 113.933678), HK Lands Dept Traverse Map No.9, NLB Route 11 bus stop, 2019 HAD Rural Election (composite indigenous village 黃家圍及龍井頭). Ref: Tung Chung–Tai O Study Report (東涌至大澳研究報告), PDF p.99 (printed p.71) §3.1.5: '黃家圍是一條東涌的村落，位於上嶺皮、下嶺皮與龍井頭之間。村民為黃氏，他們的祖先是龍井頭黃氏的分支。' PDF p.102 (printed p.74) Table 38: 黃家圍村村口及神壇（閘門公/伯公）. Confidence: MEDIUM — village-level, not building-level.","check":"✔️","clearing_note":null,"photo_path":"B03P14.jpg"},"geometry":{"type":"Point","coordinates":[113.93438,22.27701]}},{"type":"Feature","properties":{"record_no":"P15","box_no":"B03","photo_no":"B03P15","remarks_raw":"天官 黃家偉路口","Location_note":"天官 黃家偉路口","latitude":22.27701,"longitude":113.93438,"coordinate_source":"Google Maps (user-provided) + OpenStreetMap + HK Gov sources + Tung Chung Tai O Study Report (PDF)","coordinate_confidence":"MEDIUM","coordinate_note":"天官 黃家偉路口 — '黃家偉' likely a variant or colloquial form of '黃家圍' (Wong Ka Wai). Coordinates assigned to 黃家圍 village center (OSM: 22.277005, 113.934380). 黃家圍 (Wong Ka Wai), Tung Chung (東涌), Lantau Island (大嶼山), Hong Kong. Ref: Tung Chung–Tai O Study Report (東涌至大澳研究報告), PDF p.99 (printed p.71): village documented as 黃家圍. No '黃家偉' found in any source — likely transcription variant. Source: OpenStreetMap + HK Gov + PDF. Confidence: MEDIUM. CHECK original spelling '黃家偉' vs standard '黃家圍'.","check":"✔️","clearing_note":null,"photo_path":"B03P15.jpg"},"geometry":{"type":"Point","coordinates":[113.93438,22.27701]}},{"type":"Feature","properties":{"record_no":"P16","box_no":"B03","photo_no":"B03P16","remarks_raw":"黃家圍村口","Location_note":"黃家圍村口","latitude":22.27701,"longitude":113.93438,"coordinate_source":"Google Maps (user-provided) + OpenStreetMap + HK Gov sources + Tung Chung Tai O Study Report (PDF)","coordinate_confidence":"MEDIUM","coordinate_note":"黃家圍 (Wong Ka Wai), Tung Chung (東涌), Lantau Island (大嶼山), Islands District (離島區), Hong Kong. Coordinates: OpenStreetMap hamlet node (22.277005, 113.934380). Also confirmed by: HK Gov wastereduction.gov.hk (22.276964, 113.933678), HK Lands Dept Traverse Map No.9, NLB Route 11 bus stop, 2019 HAD Rural Election (composite indigenous village 黃家圍及龍井頭). Ref: Tung Chung–Tai O Study Report (東涌至大澳研究報告), PDF p.99 (printed p.71) §3.1.5: '黃家圍是一條東涌的村落，位於上嶺皮、下嶺皮與龍井頭之間。村民為黃氏，他們的祖先是龍井頭黃氏的分支。' PDF p.102 (printed p.74) Table 38: 黃家圍村村口及神壇（閘門公/伯公）. Confidence: MEDIUM — village-level, not building-level.","check":"✔️","clearing_note":null,"photo_path":"B03P16.jpg"},"geometry":{"type":"Point","coordinates":[113.93438,22.27701]}},{"type":"Feature","properties":{"record_no":"P17","box_no":"B03","photo_no":"B03P17","remarks_raw":"開門公（黃家圍）","Location_note":"開門公（黃家圍）","latitude":22.27701,"longitude":113.93438,"coordinate_source":"Google Maps (user-provided) + OpenStreetMap + HK Gov sources + Tung Chung Tai O Study Report (PDF)","coordinate_confidence":"MEDIUM","coordinate_note":"黃家圍 (Wong Ka Wai), Tung Chung, Lantau, Hong Kong. Coordinates: OpenStreetMap (22.277005, 113.934380). Ref: Tung Chung–Tai O Study Report (東涌至大澳研究報告), PDF p.102 (printed p.74) Table 38: '有人認為兩塊石柱是閘門公，小神壇供奉的石頭是伯公；又有人認為小神壇供奉的是閘門公。' P17 '開門公（黃家圍）' likely refers to the 閘門公 (gate god) at 黃家圍 village entrance. '開門公' may be a colloquial variant of '閘門公'. Confidence: MEDIUM — village entrance area, specific shrine documented.","check":"✔️","clearing_note":null,"photo_path":"B03P17.jpg"},"geometry":{"type":"Point","coordinates":[113.93438,22.27701]}},{"type":"Feature","properties":{"record_no":"P18","box_no":"B03","photo_no":"B03P18","remarks_raw":"春聯（黃家圍最西側一家）","Location_note":"春聯（黃家圍最西側一家）","latitude":22.27701,"longitude":113.93438,"coordinate_source":"Google Maps (user-provided) + OpenStreetMap + HK Gov sources + Tung Chung Tai O Study Report (PDF)","coordinate_confidence":"MEDIUM","coordinate_note":"黃家圍 (Wong Ka Wai), Tung Chung (東涌), Lantau Island (大嶼山), Islands District (離島區), Hong Kong. Coordinates: OpenStreetMap hamlet node (22.277005, 113.934380). Also confirmed by: HK Gov wastereduction.gov.hk (22.276964, 113.933678), HK Lands Dept Traverse Map No.9, NLB Route 11 bus stop, 2019 HAD Rural Election (composite indigenous village 黃家圍及龍井頭). Ref: Tung Chung–Tai O Study Report (東涌至大澳研究報告), PDF p.99 (printed p.71) §3.1.5: '黃家圍是一條東涌的村落，位於上嶺皮、下嶺皮與龍井頭之間。村民為黃氏，他們的祖先是龍井頭黃氏的分支。' PDF p.102 (printed p.74) Table 38: 黃家圍村村口及神壇（閘門公/伯公）. Confidence: MEDIUM — village-level, not building-level.","check":"✔️","clearing_note":null,"photo_path":"B03P18.jpg"},"geometry":{"type":"Point","coordinates":[113.93438,22.27701]}},{"type":"Feature","properties":{"record_no":"P19","box_no":"B03","photo_no":"B03P19","remarks_raw":"黃家圍祖屋前石頭崇拜","Location_note":"黃家圍祖屋前石頭崇拜","latitude":22.27701,"longitude":113.93438,"coordinate_source":"Google Maps (user-provided) + OpenStreetMap + HK Gov sources + Tung Chung Tai O Study Report (PDF)","coordinate_confidence":"MEDIUM","coordinate_note":"黃家圍 (Wong Ka Wai), Tung Chung, Lantau, Hong Kong. Coordinates: OpenStreetMap (22.277005, 113.934380). Ref: Tung Chung–Tai O Study Report (東涌至大澳研究報告), PDF p.99 (printed p.71): '村內有一間永和堂，是黃氏的宗祠' (永和堂 = Wong clan ancestral hall inside village). P19/P20 '祖屋前石頭崇拜' = stone worship in front of ancestral house. PDF p.102 (printed p.74) Table 38 documents stone worship at village entrance. PDF p.446: area has extensive stone/deity worship tradition. Confidence: MEDIUM — village-level; specific ancestral house not precisely geolocated.","check":"✔️","clearing_note":null,"photo_path":"B03P19.jpg"},"geometry":{"type":"Point","coordinates":[113.93438,22.27701]}},{"type":"Feature","properties":{"record_no":"P20","box_no":"B03","photo_no":"B03P20","remarks_raw":"黃家圍祖屋前石頭崇拜","Location_note":"黃家圍祖屋前石頭崇拜","latitude":22.27701,"longitude":113.93438,"coordinate_source":"Google Maps (user-provided) + OpenStreetMap + HK Gov sources + Tung Chung Tai O Study Report (PDF)","coordinate_confidence":"MEDIUM","coordinate_note":"黃家圍 (Wong Ka Wai), Tung Chung, Lantau, Hong Kong. Coordinates: OpenStreetMap (22.277005, 113.934380). Ref: Tung Chung–Tai O Study Report (東涌至大澳研究報告), PDF p.99 (printed p.71): '村內有一間永和堂，是黃氏的宗祠' (永和堂 = Wong clan ancestral hall inside village). P19/P20 '祖屋前石頭崇拜' = stone worship in front of ancestral house. PDF p.102 (printed p.74) Table 38 documents stone worship at village entrance. PDF p.446: area has extensive stone/deity worship tradition. Confidence: MEDIUM — village-level; specific ancestral house not precisely geolocated.","check":"✔️","clearing_note":null,"photo_path":"B03P20.jpg"},"geometry":{"type":"Point","coordinates":[113.93438,22.27701]}}]}
}
</script>

<script>
window.__pageLoadedAt = new Date().toISOString();
(function () {
  'use strict';

  function showFatalError(title, lines) {
    var html = '<div class="fatal-error"><div class="box"><h2>' + title + '</h2>';
    lines.forEach(function (ln) {
      html += '<p>' + ln.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</p>';
    });
    html += '<code>cd "' + window.location.pathname.replace(/\/[^\/]*$/, '') + '"\npython3 -m http.server 8000</code>';
    html += '<p>Then open:</p>';
    html += '<code>http://127.0.0.1:8000/index_custom_v1.html</code>';
    html += '<div class="note">This page needs its sibling folders (css/, js/, data/, images/) to load. Previewing the single HTML file in a sandboxed file viewer will not resolve those relative paths.</div>';
    html += '</div></div>';
    var div = document.createElement('div');
    div.innerHTML = html;
    document.body.appendChild(div.firstElementChild);
  }

  /* If Leaflet is missing, the page cannot render */
  if (typeof L === 'undefined') {
    showFatalError(
      'Leaflet failed to load',
      ['The browser could not load js/leaflet.js. Please serve the entire project folder via HTTP instead of opening this single HTML file directly.']
    );
    return;
  }

  /* =========================================================================
   * 0. Constants: all raster bounds match original index.html exactly
   * ========================================================================= */

  var RASTERS = [
    { url: 'data/OPM100_2025_0.png', label: 'Lantau 1:100',
      bounds: [[22.076205181083964, 113.75167100210537],
               [22.624727555473488, 114.51155829843452]] },
    { url: 'data/9SEA_1.png', label: '9SE-A West',
      bounds: [[22.273607952312364, 113.89769308407159],
               [22.300758044667496, 113.93413201704129]] },
    { url: 'data/9SEB_2.png', label: '9SE-B East',
      bounds: [[22.273666401328807, 113.93408524462212],
               [22.300808410150857, 113.9705172786357]] }
  ];

  var INITIAL_CENTER = [22.27708, 113.93440];
  var INITIAL_ZOOM = 19;

  var CONFIDENCE_ORDER = ['LOW', 'LOW-MEDIUM', 'MEDIUM', 'MEDIUM-HIGH'];
  var CONFIDENCE_COLOR = {
    'LOW': '#c9dcea', 'LOW-MEDIUM': '#8fb8d4',
    'MEDIUM': '#4a90c2', 'MEDIUM-HIGH': '#17608f'
  };

  /* =========================================================================
   * 1. Utilities
   * ========================================================================= */
  function val(v) {
    if (v === null || v === undefined) return null;
    var s = String(v).trim();
    return s === '' ? null : s;
  }
  function esc(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function el(tag, cls, txt) {
    var n = document.createElement(tag);
    if (cls) n.className = cls;
    if (txt !== undefined) n.textContent = txt;
    return n;
  }

  /* =========================================================================
   * 2. Build records from GeoJSON (read directly from global var)
   * ========================================================================= */
  var state = {
    records: [], markers: [], byId: {}, selectedId: null,
    filters: {}, allValues: {}, halo: null
  };

  function buildRecords(fc) {
    if (!fc || !fc.features) return [];
    return fc.features.map(function (f) {
      var p = f.properties || {};
      var lat = parseFloat(p.latitude);
      var lng = parseFloat(p.longitude);
      if (!isFinite(lat) || !isFinite(lng)) {
        if (f.geometry && f.geometry.coordinates) {
          lng = f.geometry.coordinates[0];
          lat = f.geometry.coordinates[1];
        }
      }
      return {
        props: p,
        id: val(p.record_no) || val(p.photo_no) || String(Math.random()),
        lat: lat, lng: lng
      };
    }).filter(function (r) { return isFinite(r.lat) && isFinite(r.lng); });
  }

  /* =========================================================================
   * 3. Map + raster
   *    Uses CartoDB Positron base map (light, ideal under scanned maps)
   *    plus original 3 rasters with exact same bounds as index.html
   * ========================================================================= */
  var map, cluster, rasterGroup, currentOpacity = 0.60;

  function initMap() {
    map = L.map('map', {
      zoomControl: false, maxZoom: 22, minZoom: 1,
      preferCanvas: false
    }).setView(INITIAL_CENTER, INITIAL_ZOOM);

    L.control.zoom({ position: 'topleft' }).addTo(map);

    /* Base map: CartoDB Positron (light) */
    var positron = L.tileLayer(
      'https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
        subdomains: 'abcd',
        maxNativeZoom: 20, maxZoom: 22,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions" target="_blank">CARTO</a>'
      });

    var osm = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxNativeZoom: 19, maxZoom: 22,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank">OpenStreetMap</a> contributors'
    });

    positron.addTo(map);

    L.control.layers(
      { 'Positron (light)': positron, 'OSM (streets)': osm },
      {},
      { position: 'topright', collapsed: true }
    ).addTo(map);

    /* Raster overlays: same files and bounds as original index.html */
    map.createPane('pane_raster');
    map.getPane('pane_raster').style.zIndex = 350;

    rasterGroup = L.layerGroup();
    RASTERS.forEach(function (r) {
      L.imageOverlay(r.url, r.bounds, {
        pane: 'pane_raster', opacity: currentOpacity, interactive: false
      }).addTo(rasterGroup);
    });
    rasterGroup.addTo(map);

    /* Selected marker halo pane (always on top) */
    map.createPane('pane_selected');
    map.getPane('pane_selected').style.zIndex = 650;
    map.getPane('pane_selected').style.pointerEvents = 'none';

    /* Photo marker pane (above raster) */
    map.createPane('pane_photo');
    map.getPane('pane_photo').style.zIndex = 420;

    map.attributionControl.setPrefix(
      '<a href="https://github.com/qgis2web/qgis2web" target="_blank">qgis2web</a> &middot; ' +
      '<a href="https://leafletjs.com" target="_blank">Leaflet</a>');

    try { new L.Hash(map); } catch (e) { /* hash optional */ }
  }

  function wireRasterControls() {
    var toggle = document.getElementById('rasterToggle');
    var slider = document.getElementById('rasterOpacity');
    var label = document.getElementById('opacityVal');

    toggle.addEventListener('change', function () {
      if (toggle.checked) rasterGroup.addTo(map);
      else map.removeLayer(rasterGroup);
    });

    slider.addEventListener('input', function () {
      currentOpacity = parseInt(slider.value, 10) / 100;
      label.textContent = slider.value + '%';
      rasterGroup.eachLayer(function (lyr) { lyr.setOpacity(currentOpacity); });
    });
  }

  /* =========================================================================
   * 4. Markers with clustering
   * ========================================================================= */
  function styleFor(rec) {
    return {
      pane: 'pane_photo', radius: 7, opacity: 1, weight: 1.5,
      color: '#1f2933', fill: true, fillOpacity: 1,
      fillColor: CONFIDENCE_COLOR[val(rec.props.coordinate_confidence)] || '#9aa7b3',
      interactive: true,
      bubblingMouseEvents: false
    };
  }
  function styleSelected(rec) {
    var s = styleFor(rec);
    s.radius = 11; s.weight = 4; s.color = '#ffffff';
    s.fillColor = '#ffb703'; s.className = 'marker-selected';
    return s;
  }
  function styleHalo() {
    return {
      pane: 'pane_selected', radius: 14, opacity: 1, weight: 5,
      color: '#ffffff', fill: true, fillOpacity: 0.25, fillColor: '#ffb703',
      interactive: false, className: 'marker-halo'
    };
  }

  function buildMarkers() {
    cluster = L.markerClusterGroup({
      showCoverageOnHover: false,
      spiderfyDistanceMultiplier: 3,
      maxClusterRadius: 28,
      iconCreateFunction: function (c) {
        var n = c.getChildCount();
        var size = n < 10 ? 34 : (n < 50 ? 40 : 46);
        return L.divIcon({
          html: '<div class="mc-icon" style="width:' + size + 'px;height:' + size + 'px">' + n + '</div>',
          className: 'mc-wrap',
          iconSize: [size, size]
        });
      }
    });
    cluster.addTo(map);

    state.records.forEach(function (rec) {
      var m = L.circleMarker([rec.lat, rec.lng], styleFor(rec));
      m.on('click', function () { selectMarker(rec.id); });
      m.on('add', function () {
        setMarkerClass(m, state.selectedId === rec.id);
      });
      state.byId[rec.id] = m;
      state.markers.push({ id: rec.id, marker: m, record: rec });
    });
  }

  /* =========================================================================
   * 5. Filters — dynamically built from attribute table
   *    Fields: photo_no, record_no, Location_note, remarks_raw,
   *           coordinate_confidence
   * ========================================================================= */
  var FILTER_DEFS = [
    { key: 'photo_no',              label: 'photo_no',              get: function (r) { return val(r.props.photo_no) || '(empty)'; } },
    { key: 'record_no',             label: 'record_no',             get: function (r) { return val(r.props.record_no) || '(empty)'; } },
    { key: 'Location_note',         label: 'Location_note',         get: function (r) { return val(r.props.Location_note) || '(empty)'; } },
    { key: 'remarks_raw',           label: 'remarks_raw',          get: function (r) { return val(r.props.remarks_raw) || '(empty)'; } },
    { key: 'coordinate_confidence', label: 'coordinate_confidence', get: function (r) { return val(r.props.coordinate_confidence) || '(empty)'; } }
  ];

  function orderValues(key, values) {
    if (key === 'coordinate_confidence') {
      return values.slice().sort(function (a, b) {
        var ia = CONFIDENCE_ORDER.indexOf(a), ib = CONFIDENCE_ORDER.indexOf(b);
        if (ia < 0) ia = 99;
        if (ib < 0) ib = 99;
        return ia - ib;
      });
    }
    return values.slice().sort(function (a, b) { return a.localeCompare(b, 'zh-Hant'); });
  }

  function buildFilters() {
    var body = document.getElementById('filterBody');
    body.innerHTML = '';
    state.filters = {};
    state.allValues = {};

    FILTER_DEFS.forEach(function (def) {
      var counts = {};
      state.records.forEach(function (r) {
        var v = def.get(r);
        counts[v] = (counts[v] || 0) + 1;
      });
      var values = orderValues(def.key, Object.keys(counts));

      state.filters[def.key] = new Set(values);
      state.allValues[def.key] = values.slice();

      var group = el('div', 'filter-group');
      var label = el('div', 'label');
      label.appendChild(el('span', null, def.label));
      label.appendChild(el('span', 'n', values.length + ' values'));
      group.appendChild(label);

      var opts = el('div', 'opts');
      values.forEach(function (v) {
        var lab = el('label', 'opt');
        var cb = document.createElement('input');
        cb.type = 'checkbox'; cb.checked = true; cb.value = v;
        cb.addEventListener('change', function () {
          if (cb.checked) state.filters[def.key].add(v);
          else state.filters[def.key].delete(v);
          applyFilters();
        });
        lab.appendChild(cb);
        lab.appendChild(el('span', 'txt', v));
        lab.appendChild(el('span', 'cnt', '(' + counts[v] + ')'));
        opts.appendChild(lab);
      });
      group.appendChild(opts);
      body.appendChild(group);
    });
  }

  function recordMatches(rec) {
    for (var i = 0; i < FILTER_DEFS.length; i++) {
      var def = FILTER_DEFS[i];
      if (!state.filters[def.key].has(def.get(rec))) return false;
    }
    return true;
  }

  function applyFilters() {
    var shown = 0;
    cluster.clearLayers();
    state.markers.forEach(function (m) {
      if (recordMatches(m.record)) { cluster.addLayer(m.marker); shown++; }
    });
    document.getElementById('shownCount').textContent = shown;
    document.getElementById('totalCount').textContent = state.records.length;

    if (state.selectedId) {
      var still = state.records.some(function (r) {
        return r.id === state.selectedId && recordMatches(r);
      });
      if (!still) {
        deselect();
        clearRight('Selected record is not in current filter');
      }
    }
  }

  /* =========================================================================
   * 6. Right panel: photo + selected metadata fields only
   *    Shows: file_name (= photo_path), place_name (= Location_note),
   *           capture_date (not in data -> shows —), photo_subject (= remarks_raw),
   *           direction (not in data -> shows —), location_precision (= coordinate_confidence),
   *           location_source (= coordinate_source), notes (= coordinate_note),
   *           location_note (= Location_note)
   *    Does NOT show all database fields.
   * ========================================================================= */
  function showRecord(rec) {
    var p = rec.props;
    var photoNo = val(p.photo_no) || rec.id;
    var photoPath = val(p.photo_path);
    var locNote = val(p.Location_note);
    var remarksRaw = val(p.remarks_raw);
    var coordConf = val(p.coordinate_confidence);
    var coordSrc = val(p.coordinate_source);
    var coordNote = val(p.coordinate_note);

    var html = '';

    /* Header: file_name */
    html += '<div class="photo-head">';
    html += '<div class="fname">' + esc(photoPath || photoNo) + '</div>';
    html += '<div class="chips">';
    html += '<span class="chip">' + esc(photoNo) + '</span>';
    if (coordConf) {
      var dotColor = CONFIDENCE_COLOR[coordConf] || '#9aa7b3';
      html += '<span class="chip" style="border-color:' + dotColor + ';background:' + dotColor + '22">' + esc(coordConf) + '</span>';
    }
    html += '</div>';
    html += '</div>';

    /* Photo */
    html += '<div class="photo-frame">';
    if (photoPath) {
      var imgSrc = 'images/' + String(photoPath).replace(/[\\/:]/g, '_').trim();
      html += '<img id="detailPhoto" alt="' + esc(photoNo) + '" src="' + esc(imgSrc) + '">';
    } else {
      html += '<div class="noimg">No photo_path for this record<small>' + esc(rec.id) + '</small></div>';
    }
    html += '</div>';

    /* Metadata: only the requested fields */
    html += '<div class="meta">';

    /* file_name */
    html += metaRow('file_name', photoPath);
    /* place_name (= Location_note) */
    html += metaRow('place_name', locNote);
    /* capture_date — not present in data */
    html += metaRow('capture_date', null);
    /* photo_subject (= remarks_raw) */
    html += metaRow('photo_subject', remarksRaw);
    /* direction — not present in data */
    html += metaRow('direction', null);
    /* location_precision (= coordinate_confidence) */
    html += metaRow('location_precision', coordConf);
    /* location_source (= coordinate_source) */
    html += metaRow('location_source', coordSrc, true);
    /* notes (= coordinate_note) */
    html += metaRow('notes', coordNote);
    /* location_note (= Location_note) */
    html += metaRow('location_note', locNote);

    html += '</div>';

    /* Collapsible clearing note (not all DB fields shown by default) */
    var clrNote = val(p.clearing_note);
    if (clrNote) {
      html += '<details class="tech"><summary>Clearing note (supplementary)</summary><div class="inner">';
      html += '<div class="blk"><div class="k">clearing_note</div><div class="v">' + esc(clrNote) + '</div></div>';
      html += '</div></details>';
    }

    html += '<div class="foot-note">Photo loaded from images/ via photo_path. ' +
            'Fields mapped from data/module1_photopath_5.js. ' +
            'Original data has not been modified.</div>';

    var right = document.getElementById('rightBody');
    right.innerHTML = html;

    var img = document.getElementById('detailPhoto');
    if (img) {
      img.addEventListener('error', function () {
        var box = document.querySelector('.photo-frame');
        if (box) {
          box.innerHTML = '<div class="noimg">Photo load failed<small>' +
                          esc(img.getAttribute('src')) + '</small></div>';
        }
      });
    }
  }

  function metaRow(label, value, mono) {
    var cls = mono ? 'meta-value mono' : 'meta-value';
    if (value === null || value === undefined) {
      return '<div class="meta-row"><span class="meta-label">' + esc(label) + '</span>' +
             '<span class="meta-value missing">&mdash;</span></div>';
    }
    return '<div class="meta-row"><span class="meta-label">' + esc(label) + '</span>' +
           '<span class="' + cls + '">' + esc(value) + '</span></div>';
  }

  function clearRight(msg) {
    document.getElementById('rightBody').innerHTML =
      '<div class="placeholder"><div class="big">&#128506;</div>' +
      (msg || 'Click a photo marker on the map<br>to view photo &amp; metadata') + '</div>';
  }

  /* =========================================================================
   * 7. Selection and highlight
   * ========================================================================= */
  function setMarkerClass(marker, on) {
    var node = marker && marker.getElement ? marker.getElement() : null;
    if (!node) return;
    if (on) node.classList.add('marker-selected');
    else node.classList.remove('marker-selected');
  }

  function showHalo(latlng) {
    if (!latlng) return;
    if (!state.halo) {
      state.halo = L.circleMarker(latlng, styleHalo()).addTo(map);
    } else {
      state.halo.setLatLng(latlng);
    }
  }
  function clearHalo() {
    if (state.halo) { map.removeLayer(state.halo); state.halo = null; }
  }

  function deselect() {
    if (state.selectedId && state.byId[state.selectedId]) {
      var old = state.byId[state.selectedId];
      var rec = null;
      for (var i = 0; i < state.records.length; i++) {
        if (state.records[i].id === state.selectedId) { rec = state.records[i]; break; }
      }
      if (rec) old.setStyle(styleFor(rec));
      setMarkerClass(old, false);
    }
    state.selectedId = null;
    clearHalo();
  }

  function selectMarker(id) {
    if (state.selectedId === id) return;
    deselect();
    state.selectedId = id;
    var m = state.byId[id];
    var rec = null;
    for (var i = 0; i < state.records.length; i++) {
      if (state.records[i].id === id) { rec = state.records[i]; break; }
    }
    if (!m || !rec) return;
    m.setStyle(styleSelected(rec));
    setMarkerClass(m, true);
    m.bringToFront();
    showHalo(m.getLatLng());
    showRecord(rec);
  }

  /* =========================================================================
   * 8. Buttons
   * ========================================================================= */
  function wireButtons() {
    document.getElementById('btnSelectAll').addEventListener('click', function () {
      Object.keys(state.allValues).forEach(function (k) {
        state.filters[k] = new Set(state.allValues[k]);
      });
      document.querySelectorAll('#filterBody input[type=checkbox]').forEach(function (cb) {
        cb.checked = true;
      });
      applyFilters();
    });

    document.getElementById('btnClear').addEventListener('click', function () {
      Object.keys(state.filters).forEach(function (k) { state.filters[k] = new Set(); });
      document.querySelectorAll('#filterBody input[type=checkbox]').forEach(function (cb) {
        cb.checked = false;
      });
      deselect();
      applyFilters();
      clearRight('No records match current filter');
    });
  }

  /* =========================================================================
   * 9. Boot
   * ========================================================================= */
  function boot() {
    initMap();
    wireRasterControls();

    var fc = window.json_module1_photopath_5;
    if (!fc) {
      showFatalError(
        'Photo data not available',
        ['The page could not read json_module1_photopath_5. Please serve the whole project folder via HTTP rather than opening this single HTML file directly.']
      );
      return;
    }

    state.records = buildRecords(fc);
    buildMarkers();
    buildFilters();
    applyFilters();
    wireButtons();

    var coordCount = {};
    state.records.forEach(function (r) {
      coordCount[r.lat.toFixed(5) + ',' + r.lng.toFixed(5)] = 1;
    });
    var n = Object.keys(coordCount).length;

    document.getElementById('mapStatusText').textContent =
      state.records.length + ' photos / ' + n + ' unique coordinates / click cluster to spiderfy';
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
})();
</script>
</body>
</html>
