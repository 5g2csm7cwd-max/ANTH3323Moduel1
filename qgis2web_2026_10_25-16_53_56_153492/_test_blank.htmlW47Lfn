<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="color-scheme" content="light">
<title>ANTH3323 Module 1 — Interactive Photo Map</title>
<link rel="icon" href="data:,">

<!-- Reuse existing qgis2web resources (relative paths; no new/modified css, js, data, images) -->
<link rel="stylesheet" href="css/leaflet.css">
<link rel="stylesheet" href="css/MarkerCluster.css">
<link rel="stylesheet" href="css/MarkerCluster.Default.css">

<style>
:root{
  --bg:#eef1f4; --panel:#fff; --line:#dde3e9; --ink:#1f2933; --muted:#66727f;
  --accent:#17608f; --accent-soft:#e6f0f7; --warn:#a15c07;
  --c-low:#c9dcea; --c-lowmid:#8fb8d4; --c-med:#4a90c2; --c-high:#17608f;
  --highlight:#ffb703;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang HK","PingFang TC",
              "Microsoft JhengHei",Roboto,sans-serif;
  font-size:14px;line-height:1.45;color:var(--ink);background:var(--bg);
  overflow:hidden;-webkit-text-size-adjust:100%;
}
/* Fatal error overlay */
.fatal-error{
  position:fixed;inset:0;z-index:2000;display:flex;align-items:center;justify-content:center;
  background:rgba(239,243,247,.96);padding:20px;
}
.fatal-error .box{
  max-width:560px;width:100%;background:#fff;border:1px solid var(--line);border-radius:10px;
  padding:24px;box-shadow:0 8px 30px rgba(16,24,32,.18);
}
.fatal-error h2{font-size:17px;margin-bottom:12px;color:#8a2a2a}
.fatal-error p{font-size:13.5px;line-height:1.6;margin-bottom:12px;color:#3b4652}
.fatal-error code{
  display:block;background:#f4f6f8;border:1px solid var(--line);border-radius:6px;
  padding:10px 12px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12.5px;
  color:#1f2933;white-space:pre-wrap;word-break:break-all;margin-bottom:12px;
}
.fatal-error .note{
  font-size:12px;color:var(--muted);background:#fafbfc;border:1px solid var(--line);
  border-radius:6px;padding:10px 12px;
}

/* ---------------- Topbar ---------------- */
.topbar{
  flex:0 0 auto;display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;
  padding:9px 16px;background:var(--panel);border-bottom:1px solid var(--line);
}
.topbar h1{font-size:15px;font-weight:700}
.topbar .sub{font-size:12px;color:var(--muted)}
.topbar .spacer{flex:1 1 auto}
.topbar .hint{font-size:11.5px;color:var(--muted)}

/* ---------------- Columns ---------------- */
.columns{flex:1 1 auto;display:grid;min-height:0;grid-template-columns:300px minmax(0,1fr) 370px}
.col{min-height:0;min-width:0;overflow:hidden;display:flex;flex-direction:column}
.col-left{background:var(--panel);border-right:1px solid var(--line)}
.col-map{background:#dfe6ec;position:relative}
.col-right{background:var(--panel);border-left:1px solid var(--line)}
.scroll{overflow-y:auto;-webkit-overflow-scrolling:touch;padding:14px}

/* ---------------- Filters ---------------- */
.panel-title{
  font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;
  color:var(--muted);margin-bottom:10px;
}
.actions{display:flex;gap:8px;margin-bottom:10px}
.actions button{
  flex:1;padding:7px 10px;font:inherit;font-size:12.5px;font-weight:600;color:var(--ink);
  background:#fff;border:1px solid var(--line);border-radius:6px;cursor:pointer;
  transition:background .14s,border-color .14s;
}
.actions button:hover{background:#eef2f6;border-color:#c6d0da}
.actions button:active{background:#e3eaf0}

.count-box{
  display:flex;align-items:baseline;gap:6px;padding:9px 11px;margin-bottom:14px;
  background:var(--accent-soft);border:1px solid #cfe0ee;border-radius:6px;
  font-size:12.5px;color:#2b4a63;
}
.count-box b{font-size:16px;color:var(--accent);font-weight:700}

.filter-group{margin-bottom:16px}
.filter-group > .label{
  display:flex;justify-content:space-between;align-items:baseline;gap:8px;
  font-size:12px;font-weight:700;padding-bottom:5px;margin-bottom:6px;
  border-bottom:1px solid var(--line);
}
.filter-group > .label .n{font-weight:500;font-size:11px;color:var(--muted)}
.opts{max-height:240px;overflow-y:auto}
.opt{display:flex;align-items:flex-start;gap:8px;padding:4px 2px;cursor:pointer;font-size:12.5px}
.opt:hover{color:var(--accent)}
.opt input{margin:2px 0 0;flex:0 0 auto;accent-color:var(--accent);cursor:pointer}
.opt .txt{word-break:break-word}
.opt .cnt{color:var(--muted);font-size:11px}

/* ---------------- Map ---------------- */
#map{width:100%;height:100%;background:#dfe6ec}
.leaflet-container{font:inherit}
.leaflet-container .leaflet-control-attribution{font-size:10.5px}

.map-status{
  position:absolute;z-index:1000;left:10px;bottom:10px;display:flex;gap:8px;align-items:center;
  padding:6px 10px;font-size:11.5px;color:#33414d;background:rgba(255,255,255,.94);
  border:1px solid var(--line);border-radius:6px;box-shadow:0 1px 4px rgba(16,24,32,.14);
}
.map-status .sw{width:10px;height:10px;border-radius:50%;display:inline-block}

/* Raster control */
.raster-ctl{
  position:absolute;z-index:1000;right:10px;bottom:30px;width:190px;
  padding:9px 10px;background:rgba(255,255,255,.95);border:1px solid var(--line);
  border-radius:6px;box-shadow:0 1px 4px rgba(16,24,32,.14);font-size:11.5px;
}
.raster-ctl .row{display:flex;align-items:center;gap:6px}
.raster-ctl .row + .row{margin-top:7px}
.raster-ctl label{cursor:pointer;user-select:none}
.raster-ctl input[type=range]{flex:1;accent-color:var(--accent)}
.raster-ctl .val{color:var(--muted);min-width:30px;text-align:right;font-variant-numeric:tabular-nums}

/* Legend */
.legend{
  position:absolute;z-index:1000;left:10px;top:78px;padding:8px 10px;
  background:rgba(255,255,255,.95);border:1px solid var(--line);border-radius:6px;
  box-shadow:0 1px 4px rgba(16,24,32,.14);font-size:11px;color:#33414d;
}
.legend .t{font-weight:700;font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:5px}
.legend .it{display:flex;align-items:center;gap:6px;padding:1.5px 0}
.legend .dot{width:10px;height:10px;border-radius:50%;border:1.5px solid #1f2933;flex:0 0 auto}

/* Cluster icon */
.mc-wrap{background:none;border:0}
.mc-icon{
  display:flex;align-items:center;justify-content:center;border-radius:50%;
  background:#17608f;color:#fff;font-size:12.5px;font-weight:700;
  border:2px solid #fff;box-shadow:0 1px 6px rgba(16,24,32,.35);
  transition:transform .12s;
}
.mc-icon:hover{transform:scale(1.08)}

/* Selected marker highlight */
.marker-selected{animation:pulse 1.4s ease-out infinite}
@keyframes pulse{
  0%{stroke-opacity:1;stroke-width:4}
  70%{stroke-opacity:.25;stroke-width:12}
  100%{stroke-opacity:1;stroke-width:4}
}
.marker-halo{animation:haloPulse 1.6s ease-out infinite}
@keyframes haloPulse{
  0%{stroke-opacity:.95;stroke-width:5;fill-opacity:.30}
  70%{stroke-opacity:.15;stroke-width:14;fill-opacity:.08}
  100%{stroke-opacity:.95;stroke-width:5;fill-opacity:.30}
}
@media (prefers-reduced-motion:reduce){
  .marker-selected,.marker-halo{animation:none}
}

/* ---------------- Photo + metadata ---------------- */
.placeholder{padding:44px 18px;text-align:center;color:var(--muted);font-size:13px}
.placeholder .big{font-size:26px;margin-bottom:8px;opacity:.5}

.photo-head{padding:10px 14px;border-bottom:1px solid var(--line);background:#fafbfc}
.photo-head .fname{font-size:13.5px;font-weight:700;word-break:break-all}
.chips{display:flex;flex-wrap:wrap;gap:5px;margin-top:5px}
.chip{
  display:inline-block;padding:2px 8px;font-size:11px;background:var(--accent-soft);
  color:#2b5e85;border:1px solid #cfe0ee;border-radius:10px;
}

.photo-frame{padding:12px 14px;border-bottom:1px solid var(--line)}
.photo-frame img{width:100%;height:auto;display:block;border-radius:6px;border:1px solid var(--line);background:#eceff2}
.photo-frame .noimg{
  padding:28px 12px;text-align:center;font-size:12.5px;color:var(--warn);
  background:#fdf6e8;border:1px dashed #e2c78d;border-radius:6px;
}
.photo-frame .noimg small{display:block;margin-top:4px;color:#8a7a5c;word-break:break-all}

.meta{padding:12px 14px 6px}
.meta-row{padding:7px 0;border-bottom:1px solid #eef1f4}
.meta-row:last-child{border-bottom:0}
.meta-label{
  display:block;font-size:10.5px;font-weight:700;letter-spacing:.06em;
  text-transform:uppercase;color:var(--muted);margin-bottom:2px;
}
.meta-value{font-size:13px;word-break:break-word}
.meta-value.missing{color:#aeb8c2}
.meta-value.mono{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px}

details.tech{margin:6px 14px 14px;border:1px solid var(--line);border-radius:6px;background:#fafbfc}
details.tech > summary{
  cursor:pointer;padding:8px 11px;font-size:11.5px;font-weight:700;color:#45525e;
  list-style:none;
}
details.tech > summary::-webkit-details-marker{display:none}
details.tech > summary::before{content:"\25B8 ";color:var(--accent)}
details.tech[open] > summary::before{content:"\25BE "}
details.tech .inner{padding:0 11px 11px}
details.tech .blk + .blk{margin-top:9px}
details.tech .k{font-size:10px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--muted);margin-bottom:2px}
details.tech .v{font-size:11.5px;line-height:1.6;color:#3b4652;word-break:break-word}

.foot-note{
  margin:0 14px 16px;padding:9px 10px;font-size:11.5px;line-height:1.55;color:#5a6672;
  background:#f4f6f8;border:1px solid var(--line);border-radius:6px;
}

/* ---------------- Responsive ---------------- */
@media (max-width:1180px){
  .columns{grid-template-columns:260px minmax(0,1fr) 330px}
}
@media (max-width:900px){
  body{overflow:auto}
  .app{height:auto;min-height:100dvh}
  .columns{grid-template-columns:1fr;grid-template-rows:auto minmax(340px,52vh) auto}
  .col-left{border-right:0;border-bottom:1px solid var(--line)}
  .col-left .scroll{max-height:none}
  .filter-body{display:flex;gap:16px;flex-wrap:wrap}
  .filter-body .filter-group{flex:1 1 200px;margin-bottom:0}
  .filter-body .opts{max-height:none;overflow:visible}
  .col-right{border-left:0;border-top:1px solid var(--line)}
  .col-map{min-height:340px}
  .legend{font-size:10px}
}
@media (max-width:640px){
  .columns{grid-template-rows:auto 46vh auto}
  .filter-body{display:block}
  .filter-body .filter-group{margin-bottom:14px}
  .col-map{min-height:300px}
  .topbar{gap:3px 10px;padding:8px 12px}
  .topbar .hint{display:none}
  .raster-ctl{width:150px;font-size:10.5px}
}
</style>
</head>
<body>
<div class="app">

  <header class="topbar">
    <h1>ANTH3323 Module 1 &mdash; Interactive Photo Map</h1>
    <span class="sub">Tung Chung: Lung Tseng Tau / Wong Ka Wai field photos</span>
    <span class="spacer"></span>
    <span class="hint">Click a marker to view photo &amp; metadata</span>
  </header>

  <div class="columns">

    <!-- ============ Left: Filters ============ -->
    <section class="col col-left" aria-label="Filters">
      <div class="scroll">
        <div class="panel-title">Filters</div>
        <div class="actions">
          <button id="btnSelectAll" type="button">Select all</button>
          <button id="btnClear" type="button">Clear</button>
        </div>
        <div class="count-box">Showing <b id="shownCount">0</b> / <span id="totalCount">0</span> records</div>
        <div class="filter-body" id="filterBody"></div>
      </div>
    </section>

    <!-- ============ Center: Map ============ -->
    <section class="col col-map" aria-label="Interactive map">
      <div id="map"></div>

      <div class="legend" id="legend">
        <div class="t">Coordinate confidence</div>
        <div class="it"><span class="dot" style="background:#c9dcea"></span>LOW</div>
        <div class="it"><span class="dot" style="background:#8fb8d4"></span>LOW-MEDIUM</div>
        <div class="it"><span class="dot" style="background:#4a90c2"></span>MEDIUM</div>
        <div class="it"><span class="dot" style="background:#17608f"></span>MEDIUM-HIGH</div>
      </div>

      <div class="raster-ctl">
        <div class="row">
          <input type="checkbox" id="rasterToggle" checked>
          <label for="rasterToggle">Topographic maps (3)</label>
        </div>
        <div class="row">
          <input type="range" id="rasterOpacity" min="0" max="100" step="5" value="60">
          <span class="val" id="opacityVal">60%</span>
        </div>
      </div>

      <div class="map-status">
        <span class="sw" style="background:#17608f"></span>
        <span id="mapStatusText">Loading...</span>
      </div>
    </section>

    <!-- ============ Right: Photo + Metadata ============ -->
    <section class="col col-right" aria-label="Photograph and metadata">
      <div class="scroll" id="rightBody">
        <div class="placeholder">
          <div class="big">&#128506;</div>
          Click a photo marker on the map<br>to view photo &amp; metadata
        </div>
      </div>
    </section>

  </div>
</div>

<!-- Reuse existing JS (relative paths) -->
<script src="js/leaflet.js"></script>
<script src="js/leaflet.markercluster.js"></script>
<script src="js/leaflet-hash.js"></script>
<!-- Reuse existing data (read-only; not modified) -->
<script src="data/module1_photopath_5.js" onerror="window.__dataLoadFailed=true"></script>
<!-- Inline fallback: only used when the relative path cannot be resolved (e.g. sandboxed preview).
     This is a read-only copy of data/module1_photopath_5.js; the source file is not modified. -->
<script>
if (typeof window.json_module1_photopath_5 === 'undefined') {
var json_module1_photopath_5 = {"type":"FeatureCollection","name":"module1_photopath_5","crs":{"type":"name","properties":{"name":"urn:ogc:def:crs:OGC:1.3:CRS84"}},"features":[{"type":"Feature","properties":{"record_no":"P01","box_no":"B03","photo_no":"B03P01","remarks_raw":"龍井頭村口","Location_note":"龍井頭村口","latitude":22.27715,"longitude":113.93443,"coordinate_source":"Google Maps (user-provided) + OpenStreetMap + HK Gov sources + Tung Chung Tai O Study Report (PDF)","coordinate_confidence":"MEDIUM","coordinate_note":"龍井頭 (Lung Tseng Tau), Tung Chung (東涌), Lantau Island (大嶼山), Islands District (離島區), Hong Kong. Coordinates: Google Maps (user-provided: 22.277148, 113.934428). Also confirmed by: OpenStreetMap hamlet node (22.276171, 113.933930), HK Gov wastereduction.gov.hk (22.276964, 113.933678), HK Lands Dept Traverse Map No.9, NLB Route 11 bus stop, 2019 HAD Rural Election (composite indigenous village 黃家圍及龍井頭). Ref: Tung Chung–Tai O Study Report (東涌至大澳研究報告), PDF p.96 (printed p.68) §3.1.4: '龍井頭是一條東涌的村落，位於黃家圍與滿東邨之間。村落座向西北，村名有一「井」字，可能與村中一口舊井有關。' PDF p.77 (printed p.49) Location Map 1: 龍井頭村=#10, 黃家圍村=#9. Confidence: MEDIUM — village-level, not building-level.","check":"✔️","clearing_note":"對比HKMS地圖63D9SE13B00 digital typographic map（https://www.hkmapservice.gov.hk/OneStopSystem/map-search?product=OSSCatB）大概位置與google地圖標示位置有偏差，根據政府研究報告黃家圍與龍井頭佔地合併，因此認為AI提供的地點與Google地圖不完全吻合是合理的。Item no P01-10都是龍頭井附近拍攝，難以辨認實際地標，選擇統一座標。","photo_path":"B03P01.jpg"},"geometry":{"type":"Point","coordinates":[113.93443,22.27715]}},{"type":"Feature","properties":{"record_no":"P02","box_no":"B03","photo_no":"B03P02","remarks_raw":"龍井頭村口","Location_note":"龍井頭村口","latitude":22.27715,"longitude":113.93443,"coordinate_source":"Google Maps (user-provided) + OpenStreetMap + HK Gov sources + Tung Chung Tai O Study Report (PDF)","coordinate_confidence":"MEDIUM","coordinate_note":"龍井頭 (Lung Tseng Tau), Tung Chung (東涌), Lantau Island (大嶼山), Islands District (離島區), Hong Kong. Coordinates: Google Maps (user-